# OneAnswer 钢铁智能问答系统 - 环境变量配置文件
# 复制此文件为 .env 并填写您的实际配置值

# ============================================
# LLM 大语言模型配置（必填）
# ============================================

# MiniMax API 密钥
# 获取方式: https://www.minimaxi.com/platform
LLM_API_KEY=your-minimax-api-key-here

# MiniMax API 基础 URL
LLM_BASE_URL=https://api.minimaxi.chat/v1

# 模型名称
# 可选值: minimax-text-01, abab6.5s-chat, abab6-chat
LLM_MODEL=minimax-text-01

# ============================================
# 后端服务配置
# ============================================

# 运行环境
NODE_ENV=production

# 服务端口
PORT=3000

# SQLite 数据库路径（容器内路径）
DB_PATH=/app/data/one-answer.db

# ============================================
# 前端服务配置
# ============================================

# API 基础 URL（容器内使用服务名）
VITE_API_BASE_URL=http://backend:3000

# 前端服务端口（主机端口）
VITE_FRONTEND_PORT=60001

# ============================================
# 日志配置
# ============================================

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 日志文件路径
LOG_FILE=/app/logs/app.log

# ============================================
# 缓存配置
# ============================================

# 查询结果缓存时间（秒）
CACHE_TTL=3600

# 最大缓存条目数
MAX_CACHE_SIZE=1000

# ============================================
# 安全配置
# ============================================

# API 请求速率限制（每分钟请求数）
RATE_LIMIT=100

# CORS 允许的域名（生产环境请设置为实际域名）
CORS_ORIGIN=*
