# OneAnswer 炼钢行业智能问答系统 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# API配置
API_KEY=your_api_key_here
API_BASE_URL=https://api.example.com

# 数据库配置
DATABASE_PATH=database.sqlite

# LLM配置 (根据实际使用的模型服务填写)
LLM_MODEL_NAME=gpt-3.5-turbo
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# 日志配置
LOG_LEVEL=info

# 其他配置
DEBUG=false

# 日志详细配置
LOG_BODY=false
LOG_RESPONSE=false